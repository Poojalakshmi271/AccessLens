# Copy to .env (never commit .env). Only needed for the optional Node server.
PORT=3000
NODE_ENV=development

# Optional: real SMS on SOS via Twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# Required in production to use /api/sos-history and DELETE /api/detection-log
# ADMIN_KEY=

# Only if the front-end is hosted on a different origin than this server
# CORS_ORIGIN=https://username.github.io
